ir_version = "0.1"

-- API-key mode: provider-native requests plus media preparation fields.
graph llm_workflow {
    inputs = { generation = json, classification = json, embedding = json, transcription = json }
    outputs = { generated = json, classified = json, embedded = json, transcribed = json }

    nodes {
        generate = call(mcp.tool("llm", "generate"))
        classify = call(mcp.tool("llm", "classify"))
        embed = call(mcp.tool("llm", "embed"))
        transcribe = call(mcp.tool("llm", "transcribe"))
    }

    edges {
        edge generation { from = inputs.generation to = generate.inputs.arguments }
        edge classification { from = inputs.classification to = classify.inputs.arguments }
        edge generated { from = generate.outputs.value to = outputs.generated }
        edge classified { from = classify.outputs.value to = outputs.classified }
        edge embedding { from = inputs.embedding to = embed.inputs.arguments }
        edge embedded { from = embed.outputs.value to = outputs.embedded }
        edge transcription { from = inputs.transcription to = transcribe.inputs.arguments }
        edge transcribed { from = transcribe.outputs.value to = outputs.transcribed }
    }

    limits { max_mcp_calls = 4 }
}
