          },
          "description": "Call OpenAI Decisions with shared text/base64 image input and named predicate, choice or score questions. Return full answers and probabilities for caller-owned decisions.",
          "inputSchema": {
            "additionalProperties": true,
            "properties": {
              "background": {
                "const": false,
                "type": "boolean"
              },
              "input": {
                "description": "Full provider input including conversation/tool history and text or input_image parts. Images must use base64 data URLs, never remote URLs or file IDs."
              },
              "model": {
                "description": "Provider model identifier.",
                "type": "string"
              },
              "questions": {
                "description": "Named predicate, choice and score questions.",
                "items": {
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "stream": {
                "const": false,
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "name": "classify",
          "outputSchema": {
            "additionalProperties": true,
            "type": "object"
          }
